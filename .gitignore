# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
.venv
venv/

# Local database and uploaded files
/.local/
*.sqlite3
*.sqlite3-*
backend/media/*
backend/developer/test_media/
backend/developer/family_tree.html
testbed/context_retrieval/output/
testbed/**/input/*.local.json
*.log

# Local Nginx state and maintenance switch
/deploy/nginx/run/
/deploy/nginx/maintenance.flag

# Context documents for each developer
documents/*

# Android / local build outputs
.idea/
client/.gradle/
client/.gradle-user-home/
client/.kotlin/
client/**/build/
client/local.properties

# Keep only the installable debug APK from Android build outputs
!client/app/build/
client/app/build/*
!client/app/build/outputs/
client/app/build/outputs/*
!client/app/build/outputs/apk/
client/app/build/outputs/apk/*
!client/app/build/outputs/apk/debug/
client/app/build/outputs/apk/debug/*
!client/app/build/outputs/apk/distribution/

# Generated coverage reports
.coverage
htmlcov/
coverage.xml
.coverage.*
