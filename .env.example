# Necessary Keys : 
# [Non-local case] PUBLIC_ORIGIN - Backend server's public origin 
# OPENAI_API_KEY - API key for base LLM
# ELEVENLABS_API_KEY - API key for STT and TTS
# ELEVENLABS_VOICE_ID - Voice ID for TTS
# NEO4J_PASSWORD - Password for Neo4j database

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-for-shared-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver

PUBLIC_ORIGIN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

OPENAI_MODEL=gpt-4.1-mini
GRAPHITI_MODEL=gpt-4.1-mini
GRAPHITI_SEARCH_WORKERS=4
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
