# Necessary Keys : 
# [Non-local case] PUBLIC_ORIGIN - Backend server's public origin 
# OPENAI_API_KEY - API key for base LLM
# ELEVENLABS_API_KEY - API key for STT and TTS
# TTS voices are listed in TTS_VOICES in backend/configs/settings.py, not here.
# NEO4J_PASSWORD - Password for Neo4j database

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-for-shared-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver

PUBLIC_ORIGIN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Default for every model group below
DEFAULT_AI_MODEL=gpt-6-luna
DEFAULT_AI_SERVICE_TIER=fast
DEFAULT_AI_REASONING_EFFORT=none

# Per-group overrides. A commented-out value uses the default above; a blank value
# (e.g. STT_AI_REASONING_EFFORT=) is not sent, so the API default applies.
# Models without reasoning support need a blank reasoning effort.
# Daily digest (no search), graph post descriptions, feed summaries
# SUMMARY_AI_MODEL=
# SUMMARY_AI_SERVICE_TIER=
# SUMMARY_AI_REASONING_EFFORT=

# Voice reply STT correction
# STT_AI_MODEL=
# STT_AI_SERVICE_TIER=
# STT_AI_REASONING_EFFORT=

# Family history search answers, post QA
# ANSWER_AI_MODEL=
# ANSWER_AI_SERVICE_TIER=
# ANSWER_AI_REASONING_EFFORT=

# Search decision and queries for STT correction
# QUERY_AI_MODEL=
# QUERY_AI_SERVICE_TIER=
# QUERY_AI_REASONING_EFFORT=

# Graphiti relation extraction and reranking. No service tier; a blank reasoning
# effort keeps Graphiti's own default instead of DEFAULT_AI_REASONING_EFFORT.
# GRAPHITI_MODEL=
#GRAPHITI_REASONING_EFFORT=

GRAPHITI_SEARCH_WORKERS=4

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v4